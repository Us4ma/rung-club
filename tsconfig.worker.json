{
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "@cloudflare/workers-types",
      "node"
    ]
  },
  "include": [
    "apps/server/worker.ts",
    "packages/core/index.ts",
    "packages/ai",
    "packages/protocol",
    "tests/worker-room.test.ts",
    "tests/account-deletion-server.test.ts",
    "tests/player-stats-smoke.test.ts",
    "tests/roster-persistence.test.ts",
    "tests/device-session-route.test.ts",
    "tests/coins.test.ts"
  ]
}
